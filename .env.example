# Copy this file to .env and fill in local values. NEVER commit .env.

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_URI=bolt://localhost:7687

# API protection for sensitive endpoints (import / sync)
API_KEY=change-me-locally

# Docker image name (replace with your registry path once published)
API_IMAGE=event-market-graph-api:dev

# Market data
FRED_API_KEY=

# Local LLM runtime
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=

# Event data window (keep it small during development)
GDELT_START_DATE=2025-01-01
GDELT_END_DATE=2025-03-31
