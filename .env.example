# Copy this file to .env and fill in local values. NEVER commit .env (it is in .gitignore and .dockerignore).

# Neo4j. NEO4J_URI is for scripts run on the host; inside Docker Compose the API uses bolt://neo4j:7687.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_URI=bolt://localhost:7687

# Protects POST /api/ask (header X-API-Key). Empty = the endpoint is closed (503). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-locally

# API image used by Docker Compose (built locally by make docker-up, published by make docker-push)
API_IMAGE=ghcr.io/victorhenz241-eng/graphdb-event-market-api:latest

# Local LLM runtime. OLLAMA_BASE_URL is for make run on the host (native Ollama app); inside Docker Compose the API
# uses http://ollama:11434.
# The model is downloaded once by the ollama-pull service (about 2 GB). With 16 GB of memory or more,
# llama3.1:8b (about 5 GB) gives better answers.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
