// System architecture of the Docker Compose stack. Render with: dot -Tpng -Gdpi=150 docs/architecture.dot -o docs/architecture.png
// Solid arrows: a request at run time. Dashed arrows: setup, run once or on demand (seed, model pull, image push).
digraph architecture {
    graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.45, ranksep=0.75, pad=0.3, bgcolor="white",
           label=<<b>Event-Market Graph: system architecture</b><br/><font point-size="10">All published ports are bound to 127.0.0.1. Solid: request at run time. Dashed: setup (once or on demand). Dotted: optional macOS mode.</font>>,
           labelloc=t, labeljust=l];
    node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#5f6b7a", fillcolor="#ffffff", margin="0.15,0.08"];
    edge  [fontname="Helvetica", fontsize=9, color="#3d4752", fontcolor="#3d4752", arrowsize=0.7];

    subgraph cluster_host {
        label=<<b>Host machine (developer or grader)</b>>; labeljust=l; style="rounded,dashed"; color="#8a96a3"; fontsize=11;
        user    [label=<<b>Client</b><br/>browser (Swagger /docs), curl<br/>http://localhost:8080>, fillcolor="#eef2f6"];
        browser [label=<<b>Neo4j Browser</b><br/>http://localhost:7474>, fillcolor="#eef2f6"];
        make    [label=<<b>make</b><br/>docker-up, seed, model,<br/>healthcheck, docker-push>, fillcolor="#eef2f6"];
        envfile [label=<<b>.env</b> (not in Git, not in the image)<br/>NEO4J_PASSWORD, API_KEY, LLM_MODEL>, shape=note, fillcolor="#fff8e1", color="#b38f00"];
        native  [label=<<b>Native Ollama app</b> (optional)<br/>Metal GPU, 127.0.0.1:11434<br/>reached as host.docker.internal>, fillcolor="#f6f0fb", color="#8e6bb3", style="rounded,filled,dotted"];

        subgraph cluster_compose {
            label=<<b>Docker Compose stack</b> (project event-market-graph, internal network "default")>; labeljust=l;
            style="rounded,filled"; fillcolor="#f7f9fb"; color="#5f6b7a"; fontsize=11;

            proxy [label=<<b>proxy</b>: Nginx 1.27<br/>127.0.0.1:8080 → :80<br/><font point-size="9">rate limit 20 r/s, /api/ask 10 r/min (429)<br/>timeouts 120 s, /api/ask 300 s<br/>body ≤ 16 KB</font>>, fillcolor="#e3f0fb", color="#2f6ea8"];
            api   [label=<<b>api</b>: FastAPI + LangGraph agent<br/>:8000 (internal only), non-root<br/><font point-size="9">X-API-Key required on POST /api/ask<br/>guardrails: read-only Cypher, schema check, LIMIT<br/>image built locally (API_IMAGE), published on GHCR</font>>, fillcolor="#e6f4ea", color="#2e7d4f"];
            neo4j [label=<<b>neo4j</b>: Neo4j 5.26 + GDS<br/>Bolt 7687, HTTP 7474 (127.0.0.1)<br/><font point-size="9">heap 1 GB, page cache 512 MB</font>>, fillcolor="#fdeee0", color="#c0661c"];
            ollama [label=<<b>ollama</b>: Ollama 0.40.5<br/>:11434 (internal only)<br/><font point-size="9">model llama3.2:3b (default), CPU</font>>, fillcolor="#f1ebf9", color="#6b4fa0"];
            pull  [label=<<b>ollama-pull</b> (one-shot)<br/>ollama pull $LLM_MODEL<br/><font point-size="9">exits 0 when the model is in place</font>>, fillcolor="#f1ebf9", color="#6b4fa0", style="rounded,filled,dashed"];

            neo4j_data  [label="volume\nneo4j_data", shape=cylinder, fillcolor="#fdeee0", color="#c0661c", fontsize=10];
            ollama_data [label="volume\nollama_data", shape=cylinder, fillcolor="#f1ebf9", color="#6b4fa0", fontsize=10];
        }
    }

    subgraph cluster_internet {
        label=<<b>Internet</b>>; labeljust=l; style="rounded,dashed"; color="#8a96a3"; fontsize=11;
        sources  [label=<<b>Open data</b><br/>GDELT events, FRED prices>, fillcolor="#eef2f6"];
        registry [label=<<b>Ollama model registry</b><br/>registry.ollama.ai>, fillcolor="#eef2f6"];
        ghcr     [label=<<b>GitHub Container Registry</b><br/>public image of the api service<br/><font point-size="9">linux/amd64 + linux/arm64</font>>, fillcolor="#eef2f6"];
    }

    // Run-time requests
    user    -> proxy [label="HTTP :8080"];
    proxy   -> api   [label="proxy_pass api:8000\nheaders incl. X-API-Key"];
    api     -> neo4j [label="Bolt, read-only session\nparameterized Cypher"];
    api     -> ollama [label="HTTP :11434\nstructured output"];
    browser -> neo4j [label="HTTP 7474 / Bolt 7687"];
    neo4j   -> neo4j_data [arrowhead=none, style=bold];
    ollama  -> ollama_data [arrowhead=none, style=bold];

    // Configuration
    envfile -> api   [style=dashed, color="#b38f00", fontcolor="#8a6d00", label="env_file"];
    envfile -> neo4j [style=dashed, color="#b38f00", fontcolor="#8a6d00", label="NEO4J_AUTH"];

    // Setup and on-demand jobs
    pull     -> ollama   [style=dashed, label="pull request"];
    ollama   -> registry [style=dashed, dir=back, label="model download\n(~2 GB, once)"];
    make     -> api      [style=dashed, label="make seed:\ndocker compose exec api"];
    neo4j    -> sources  [style=invis];
    api      -> sources  [style=dashed, dir=back, label="HTTPS download (seed scripts)", constraint=false];
    api      -> neo4j    [style=dashed, label="MERGE (idempotent)", constraint=false];
    make     -> ghcr     [style=dashed, label="make docker-push\n(buildx, multi-arch)"];

    // Optional macOS mode (docker-compose.override.example.yml)
    api -> native [style=dotted, color="#8e6bb3", fontcolor="#6b4fa0", label="override: LLM on the host", constraint=false];
}
